{
  "name": "bm25-mono-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for bm25",
  "repository": "github:dworthen/bm25",
  "scripts": {
    "fix": "biome check --write",
    "check": "biome check . && bun run --parallel --filter '*' typecheck",
    "check:changelog": "changelog check",
    "changelog:add": "changelog add",
    "changelog:apply": "changelog apply",
    "build": "bun run ./scripts/build.ts",
    "pack": "bun run --filter @d-dev/bm25 pack",
    "publish": "bun run --parallel --filter @d-dev/bm25 publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@d-dev/bin-upload": "latest",
    "@d-dev/changelog": "latest",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "workspaces": [
    "packages/*"
  ]
}